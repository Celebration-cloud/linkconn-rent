# Neon PostgreSQL
DATABASE_URL="postgresql://username:password@hostname/database?sslmode=require"

# Neon Auth — email and password only
NEON_AUTH_BASE_URL="https://your-neon-auth-endpoint.neonauth.dev"
NEON_AUTH_COOKIE_SECRET="replace-with-at-least-32-random-characters"
NEXT_PUBLIC_NEON_AUTH_URL="https://your-neon-auth-endpoint.neonauth.dev"

# Paystack plans and onboarding checkout
PAYSTACK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_..."
PAYSTACK_CALLBACK_URL="http://localhost:3000/billing/complete"
# Rent payments generate a per-record callback and verify exact kobo amounts
# with this same server-side secret before marking a payment paid.

# Leaflet-compatible raster tiles with place and road labels.
# Public OpenStreetMap tiles are a local-development fallback only.
NEXT_PUBLIC_LEAFLET_TILE_URL="https://your-tile-provider.example.com/{z}/{x}/{y}.png"
NEXT_PUBLIC_LEAFLET_TILE_ATTRIBUTION="Map data © OpenStreetMap contributors"

# Overpass-compatible endpoint used server-side for nearby building footprints.
# Local development falls back to the public Overpass API; production does not.
OVERPASS_API_URL="https://your-overpass-provider.example.com/api/interpreter"

# OSRM-compatible base URL used server-side for driving directions.
# Local development falls back to the public OSRM demo; production does not.
DIRECTIONS_API_URL="https://your-routing-service.example.com"

# Message Hub polling
NEXT_PUBLIC_MESSAGE_POLL_MS="5000"
NEXT_PUBLIC_MESSAGE_BACKGROUND_POLL_MS="20000"

# Optional document storage
# No provider is configured by default. Verification metadata drafts work,
# while uploads and final upload-dependent submission remain disabled.
DOCUMENT_STORAGE_PROVIDER="disabled"

# Optional authenticated Playwright journeys
E2E_TENANT_EMAIL=""
E2E_TENANT_PASSWORD=""
E2E_LANDLORD_EMAIL=""
E2E_LANDLORD_PASSWORD=""
E2E_ADMIN_EMAIL=""
E2E_ADMIN_PASSWORD=""
