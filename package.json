{
  "name": "linkconn-rent",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:unit": "vitest run",
    "check:architecture": "vitest run tests/architecture-boundaries.test.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:architecture",
    "test:e2e": "playwright test",
    "test:e2e:auth": "node scripts/auth-e2e/run.mjs",
    "test:e2e:auth:cleanup": "ts-node --project tsconfig.scripts.json scripts/auth-e2e/cleanup.ts",
    "admin:bootstrap": "ts-node --project tsconfig.scripts.json scripts/admin-bootstrap/cli.ts bootstrap",
    "admin:bootstrap:verify": "ts-node --project tsconfig.scripts.json scripts/admin-bootstrap/cli.ts verify",
    "admin:bootstrap:recover-password": "ts-node --project tsconfig.scripts.json scripts/admin-bootstrap/cli.ts recover-password",
    "admin:preflight": "ts-node --project tsconfig.scripts.json scripts/admin-preflight.ts",
    "prisma:generate": "prisma generate",
    "prisma:db-push": "prisma db push",
    "prisma:studio": "prisma studio",
    "db:seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/seed.ts",
    "db:properties:dry-run": "ts-node --project tsconfig.scripts.json scripts/property-load-test/cli.ts dry-run",
    "db:properties:seed": "ts-node --project tsconfig.scripts.json scripts/property-load-test/cli.ts seed",
    "db:properties:verify": "ts-node --project tsconfig.scripts.json scripts/property-load-test/cli.ts verify",
    "db:properties:benchmark": "ts-node --project tsconfig.scripts.json scripts/property-load-test/cli.ts benchmark",
    "db:properties:cleanup": "ts-node --project tsconfig.scripts.json scripts/property-load-test/cli.ts cleanup"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@neondatabase/auth": "^0.4.2-beta",
    "@prisma/client": "^6.4.0",
    "@types/leaflet": "^1.9.21",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "next": "16.2.11",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.82.0",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/leaflet.markercluster": "^1.5.5",
    "@types/node": "^22.13.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.20.1",
    "eslint-config-next": "16.2.11",
    "eslint-plugin-react-hooks": "7.1.1",
    "postcss": "^8.5.2",
    "prisma": "^6.4.0",
    "tailwindcss": "^4.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
